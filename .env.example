# Copy to .env.local. Leave unset for the labelled demo engine.
# Accounts are off by default: no sign-in is shown and everyone shares the
# open workspace with full capability. Set to true (or 1) to enable
# register/sign-in with owner-scoped documents, and set AUTH_SECRET too.
AUTH_ENABLED=
AUTH_SECRET=
META_MODEL_API_URL=https://api.meta.ai/v1/chat/completions
META_MODEL_API_KEY=
META_SPARK_MODEL=muse-spark-1.3
META_WONDER_MODEL=muse-wonder-1.0
META_VOICE_MODEL=muse-voice-transcribe-1.0
# Optional persistence: unset uses data/documents.json in the repo.
DATABASE_URL=
TRUTHLENS_STORE_FILE=
TRUTHLENS_USERS_FILE=
TRUTHLENS_MEDIA_DIR=
# Optional Python sidecar (FAISS + OCR + guard). Unset uses the in-process fallback.
FAISS_SERVICE_URL=http://127.0.0.1:8100
# Optional guard/embeddings. Unset keeps the regex screen and lazy model load.
HF_TOKEN=
TRUTHLENS_GUARD_MODEL=
TRUTHLENS_EMBED_MODEL=
TRUTHLENS_RERANK_MODEL=
TRUTHLENS_NLI_MODEL=
# Optional eval/behaviour flags. Leave unset for defaults.
TRUTHLENS_CONFORMAL_Q=
TRUTHLENS_NO_CHALLENGE=
TRUTHLENS_NO_NLI=
# Only needed for `docker compose up`: postgres password for the db service.
POSTGRES_PASSWORD=
